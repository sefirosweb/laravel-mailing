{
    "name": "sefirosweb/laravel-mailing",
    "description": "Package to help the mailing groups in front end",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sefirosweb\\LaravelMailing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sefirosweb\\LaravelMailing\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures"
        ]
    },
    "authors": [
        {
            "name": "Sefirosweb",
            "email": "sefirosweb@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sefirosweb\\LaravelMailing\\LaravelMailingServiceProvider"
            ]
        }
    }
}
